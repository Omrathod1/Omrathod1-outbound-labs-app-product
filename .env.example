# Copy to .env.local for local development. Never commit real values.

# Supabase Postgres, used as plain Postgres through Drizzle (decision D2).
# Use the transaction pooler URL (port 6543) for the app on Netlify.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/outbound_labs

# Better Auth (decision D3). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# The public URL of this app, e.g. https://app.outboundlabs.app
BETTER_AUTH_URL=http://localhost:3000
